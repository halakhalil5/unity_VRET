{
  "environmentId": "cave",
  "displayName": "Cave",
  "phobiaType": "arachnophobia",
  "description": "Dark natural cave with narrow passages, rock ledges, and low visibility",

  "intensityLevels": {
    "0.0":  "Quiet cave, no spiders, soft ambient light and calm atmosphere",
    "0.25": "One small spider near a distant wall crack",
    "0.5":  "Several spiders on cave walls and floor with occasional movement",
    "0.75": "Many larger spiders moving across cave walls toward the player",
    "1.0":  "Dense spider presence, fast movement, and frequent ceiling drops"
  },

  "spawnPoints": [
    { "id": "sp_entrance_left",   "position": { "x": -3.0, "y": 0.0, "z":  4.0 }, "type": "ground"  },
    { "id": "sp_entrance_right",  "position": { "x":  3.0, "y": 0.0, "z":  4.0 }, "type": "ground"  },
    { "id": "sp_wall_north",      "position": { "x":  0.0, "y": 1.8, "z":  6.0 }, "type": "wall"    },
    { "id": "sp_wall_west",       "position": { "x": -5.0, "y": 1.6, "z":  0.0 }, "type": "wall"    },
    { "id": "sp_wall_east",       "position": { "x":  5.0, "y": 1.6, "z":  0.0 }, "type": "wall"    },
    { "id": "sp_ledge_high",      "position": { "x":  2.0, "y": 2.7, "z": -2.5 }, "type": "wall"    },
    { "id": "sp_ceiling_center",  "position": { "x":  0.0, "y": 3.5, "z":  0.0 }, "type": "ceiling" },
    { "id": "sp_tunnel_floor",    "position": { "x":  0.0, "y": 0.0, "z": -5.0 }, "type": "ground"  }
  ],

  "intensityParameters": {

    "spiders": {
      "countAtZero":          0,
      "countAtMax":           22,
      "sizeAtZero":           0.2,
      "sizeAtMax":            2.4,
      "speedAtZero":          0.0,
      "speedAtMax":           3.4,
      "minDistanceAtZero":    7.0,
      "minDistanceAtMax":     0.25,
      "webVisibleAbove":      0.25,
      "dropFromCeilingAbove": 0.55,
      "crawlOnFurnitureAbove":0.0
    },

    "lighting": {
      "ambientIntensityAtZero":  0.7,
      "ambientIntensityAtMax":   0.12,
      "fogDensityAtZero":        0.005,
      "fogDensityAtMax":         0.06,
      "fogColorAtMax":           "#050505",
      "lampFlickerAbove":        0.45,
      "lampFlickerSpeedAtMax":   4.0,
      "windowLightAtZero":       0.0,
      "windowLightAtMax":        0.0
    },

    "audio": {
      "roomToneAtZero":          0.45,
      "roomToneAtMax":           0.1,
      "skitteringVolumeAtZero":  0.0,
      "skitteringVolumeAtMax":   1.0,
      "webRustleAbove":          0.3,
      "heartbeatAudioAbove":     0.65,
      "heartbeatVolumeAtMax":    0.7
    },

    "environment": {
      "cobwebsVisibleAbove":     0.2,
      "cobwebsDensityAtMax":     1.0,
      "dustParticlesAtZero":     10,
      "dustParticlesAtMax":      90,
      "furnitureShadowsSharpness": 0.0
    },

    "postProcessing": {
      "vignetteIntensityAtZero": 0.2,
      "vignetteIntensityAtMax":  0.75,
      "saturationAtZero":        0.9,
      "saturationAtMax":         0.1,
      "contrastAtMax":           1.7,
      "chromaticAberrationAbove":0.65
    }
  },

  "therapistAddableAssets": [
    {
      "id":       "spider_small",
      "label":    "Small Cave Spider",
      "tags":     ["spider", "small", "cave", "arachnid"],
      "category": "creature",
      "maxCount": 28
    },
    {
      "id":       "spider_large",
      "label":    "Large Cave Spider",
      "tags":     ["spider", "large", "cave", "arachnid"],
      "category": "creature",
      "maxCount": 10
    },
    {
      "id":       "cobweb_wall",
      "label":    "Wall Cobweb Cluster",
      "tags":     ["cobweb", "wall", "spider", "nest"],
      "category": "prop",
      "maxCount": 12
    },
    {
      "id":       "cobweb_ceiling",
      "label":    "Ceiling Web Sheet",
      "tags":     ["cobweb", "ceiling", "web", "spider"],
      "category": "prop",
      "maxCount": 10
    },
    {
      "id":       "egg_sac_cluster",
      "label":    "Egg Sac Cluster",
      "tags":     ["egg", "sac", "cluster", "spider"],
      "category": "prop",
      "maxCount": 6
    }
  ],

  "therapistModifiableParameters": [
    {
      "id":      "torchMode",
      "label":   "Torch Mode",
      "type":    "enum",
      "options": ["steady", "flicker", "dim", "off"],
      "default": "steady"
    },
    {
      "id":      "mistLevel",
      "label":   "Cave Mist",
      "type":    "float",
      "min":     0.0,
      "max":     1.0,
      "default": 0.35
    },
    {
      "id":      "dripRate",
      "label":   "Water Drip Rate",
      "type":    "float",
      "min":     0.0,
      "max":     1.0,
      "default": 0.5
    },
    {
      "id":      "echoLevel",
      "label":   "Echo Strength",
      "type":    "float",
      "min":     0.0,
      "max":     1.0,
      "default": 0.6,
      "description": "Higher values increase cave reverb and distant movement perception"
    }
  ],

  "safetySettings": {
    "panicButtonEnabled":        true,
    "panicButtonAction":         "freeze_all_triggers",
    "autoReduceIfHRAbove":       130,
    "autoReduceIfGSRAbove":      2.5,
    "minimumBreakBetweenPeaks":  30,
    "maxSessionDurationSeconds": 3600
  }
}
