{
  "environmentId": "elevator",
  "displayName": "Elevator",
  "phobiaType": "claustrophobia",
  "description": "Confined metal elevator car in a high-rise building with smooth walls, dim fluorescent lighting, and potential crowd elements",
  "sceneLayout": {
    "position": { "x": 0.0, "y": 1.1, "z": -0.1 },
    "dimensions": { "x": 3.0, "y": 2.2, "z": 2.8 },
    "scale": { "x": 1.0, "y": 1.0, "z": 1.0 }
  },

  "intensityLevels": {
    "0.0":  "Open-door elevator with bright lighting, low ambient hum, and clear exit visibility",
    "0.25": "Doors mostly closed with mild motor audio, slight confinement, and sparse occupants",
    "0.5":  "Doors sealed with active movement cues, dimmer lighting, and stronger enclosed-space pressure",
    "0.75": "Crowded cabin with tighter spacing, harsher lighting/audio cues, and sustained confinement stress",
    "1.0":  "Packed enclosed cabin with alarm/emergency cues, heavy crowd pressure, and peak claustrophobic intensity"
  },

  "spawnPoints": [
    { "id": "sp_floor_center",      "position": { "x":  0.0, "y": 0.0, "z":  0.0 }, "type": "ground"  },
    { "id": "sp_floor_left",        "position": { "x": -1.2, "y": 0.0, "z":  0.0 }, "type": "ground"  },
    { "id": "sp_floor_right",       "position": { "x":  1.2, "y": 0.0, "z":  0.0 }, "type": "ground"  },
    { "id": "sp_floor_back",        "position": { "x":  0.0, "y": 0.0, "z": -1.0 }, "type": "ground"  },
    { "id": "sp_wall_left",         "position": { "x": -1.5, "y": 1.0, "z": -0.5 }, "type": "wall"    },
    { "id": "sp_wall_right",        "position": { "x":  1.5, "y": 1.0, "z": -0.5 }, "type": "wall"    },
    { "id": "sp_wall_back",         "position": { "x":  0.0, "y": 1.0, "z": -1.5 }, "type": "wall"    },
    { "id": "sp_mirror_center",     "position": { "x":  0.0, "y": 1.3, "z":  1.3 }, "type": "wall"    },
    { "id": "sp_ceiling_left",      "position": { "x": -0.8, "y": 2.2, "z":  0.0 }, "type": "ceiling" },
    { "id": "sp_ceiling_right",     "position": { "x":  0.8, "y": 2.2, "z":  0.0 }, "type": "ceiling" }
  ],

