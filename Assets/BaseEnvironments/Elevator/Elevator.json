      "position": { "x": 0.0, "y": 1.1, "z": 1.35 },
      "scale": { "x": 2.2, "y": 2.2, "z": 0.1 }
    }
  ],

  "intensityParameters": {

    "crowding": {
      "peopleCountAtZero":        0,
      "peopleCountAtMax":         8,
      "personDistanceAtZero":     5.0,
      "personDistanceAtMax":      0.5,
      "shoulderPresenceAbove":    0.35,
      "breathingAudienceAbove":   0.45,
      "personMovementAbove":      0.6,
      "personHeightVariance":     0.15
    },

    "confinement": {
      "wallProximityAtZero":      2.5,
      "wallProximityAtMax":       0.8,
      "ceilingVisibilityAtZero":  0.3,
      "ceilingVisibilityAtMax":   0.9,
      "floorReflectionAtZero":    0.0,
      "floorReflectionAtMax":     0.8,
      "mirrorDistortionAbove":    0.5,
      "metalEchoAtMax":           0.8
    },

    "lighting": {
      "ambientIntensityAtZero":   0.85,
      "ambientIntensityAtMax":    0.35,
      "fluorescentFlickerAbove":  0.4,
      "fluorescentFlickerSpeed":  1.2,
      "shadowIntensityAtMax":     0.9,
      "emergencyLightAbove":      0.75,
      "emergencyLightColor":      "#FF3333",
      "darkCornerShadowsAbove":   0.65
    },

    "audio": {
      "armbienceHumAtZero":       0.2,
      "ambientHumAtMax":          0.9,
      "elevatorMotorAbove":       0.3,
      "elevatorMotorVolumeAtMax": 0.7,
      "doorAlarmAbove":           0.65,
      "doorAlarmVolumeAtMax":     0.8,
      "respirationAudienceAbove": 0.5,
      "respirationVolumeAtMax":   0.6,
      "heartbeatAudioAbove":      0.55,
      "heartbeatVolumeAtMax":     0.7,
      "staticNoiseAbove":         0.7,
      "staticVolumeAtMax":        0.5
    },

    "environment": {
      "dustParticlesAtZero":      2,
      "dustParticlesAtMax":       25,
      "fogDensityAtZero":         0.0,
      "fogDensityAtMax":          0.04,
      "airConditioningStreamAbove": 0.35,
      "temperatureAnimationAbove": 0.5,
      "fluoriescentGlowAtMax":    0.85,
      "metalReflectivityAtMax":   0.7
    },

    "postProcessing": {
      "vignetteIntensityAtZero":  0.15,
      "vignetteIntensityAtMax":   0.85,
      "saturationAtZero":         1.0,
      "saturationAtMax":          0.55,
      "contrastAtMax":            1.5,
      "chromaticAberrationAbove": 0.5,
      "screenShakeAbove":         0.65,
      "screenShakeStrengthAtMax": 0.3,
      "perspectiveDistortAbove":  0.7,
      "perspectiveDistortMaxAtMax": 1.15
    }

  },

  "therapistAddableAssets": [
    {
      "id":       "person_adult_male",
      "label":    "Adult Male Passenger",
      "tags":     ["person", "adult", "male", "crowd"],
      "category": "character",
      "maxCount": 6
    },
    {
      "id":       "person_adult_female",
      "label":    "Adult Female Passenger",
      "tags":     ["person", "adult", "female", "crowd"],
      "category": "character",
      "maxCount": 6
    },
    {
      "id":       "person_child",
      "label":    "Child Passenger",
      "tags":     ["person", "child", "crowd"],
      "category": "character",
      "maxCount": 3
    },
    {
      "id":       "briefcase_floor",
      "label":    "Briefcase on Floor",
      "tags":     ["object", "briefcase", "clutter"],
      "category": "prop",
      "maxCount": 3
    },
    {
      "id":       "shopping_bag",
      "label":    "Shopping Bag",
      "tags":     ["object", "bag", "clutter"],
      "category": "prop",
      "maxCount": 4
    },
    {
      "id":       "stuck_sign",
      "label":    "Stuck Between Floors Sign",
      "tags":     ["warning", "text", "sign"],
      "category": "prop",
      "maxCount": 1
    },
    {
      "id":       "emergency_button_lit",
      "label":    "Glowing Emergency Button",
      "tags":     ["emergency", "button", "interactive"],
      "category": "prop",
      "maxCount": 1
    }
  ],

  "therapistModifiableParameters": [
    {
      "id":      "floorNumber",
      "label":   "Current Floor",
      "type":    "int",
      "min":     1,
      "max":     50,
      "default": 10
    },
    {
      "id":      "elevatorSpeed",
      "label":   "Elevator Speed",
      "type":    "enum",
      "options": ["stationary", "slow_ascent", "fast_ascent", "descent", "stalled"],
      "default": "stationary"
    },
    {
      "id":      "doorState",
      "label":   "Door Status",
      "type":    "enum",
      "options": ["open", "opening", "closed", "closing", "stuck"],
      "default": "open"
    },
    {
      "id":      "crowdDensity",
      "label":   "Crowd Density",
      "type":    "float",
      "min":     0.0,
      "max":     1.0,
      "default": 0.3,
      "description": "Controls number of nearby people and proximity"
    },
    {
      "id":      "lighting",
      "label":   "Lighting Condition",
      "type":    "enum",
      "options": ["bright", "normal", "dim", "emergency_red", "flickering"],
      "default": "normal"
    },
    {
      "id":      "soundTrack",
      "label":   "Audio Ambiance",
      "type":    "enum",
      "options": ["silent", "subtle_hum", "normal_operation", "alarm_triggered", "malfunction"],
      "default": "subtle_hum"
    },
    {
      "id":      "emergencyActive",
      "label":   "Emergency Scenario",
      "type":    "boolean",
      "default": false,
      "description": "Triggers alarm lights and emergency audio cues"
    },
    {
      "id":      "breathingSync",
      "label":   "Ambient Breathing Sync",
      "type":    "float",
      "min":     0.0,
      "max":     1.0,
      "default": 0.0,
      "description": "Synchronizes audience breathing patterns with therapeutic intervention"
    }
  ],

  "defaultSceneSetup": {
    "timeOfDay": "midday",
    "weather": "none",
    "buildingLocation": "downtown_high_rise",
    "elevatorStyle": "modern_corporate",
    "floorRangeMin": 1,
    "floorRangeMax": 50,
    "weatherProof": true
  }

}
