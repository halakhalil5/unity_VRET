      "scale": { "x": 0.1, "y": 2.2, "z": 2.8 }
    },
    {
      "id": "elevator_wall_right",
      "name": "Right Wall",
      "type": "wall",
      "role": "confinement_boundary",
      "position": { "x": 1.5, "y": 1.0, "z": -0.5 },
      "scale": { "x": 0.1, "y": 2.2, "z": 2.8 }
    },
    {
      "id": "elevator_wall_back",
      "name": "Back Wall",
      "type": "wall",
      "role": "confinement_boundary",
      "position": { "x": 0.0, "y": 1.0, "z": -1.5 },
      "scale": { "x": 3.0, "y": 2.2, "z": 0.1 }
    },
    {
      "id": "elevator_mirror_center",
